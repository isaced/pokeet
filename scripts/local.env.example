# Copy to scripts/local.env and fill in your own values. The file is gitignored,
# so device IDs and team IDs never end up in the repository.
#
# Both are optional:
#   - with one iPhone plugged in, the device is detected automatically;
#   - the team ID is only needed when signing fails with
#     "requires a development team".

# UDID of the iPhone to install on (xcrun devicectl list devices).
# POKEET_DEVICE_ID=00000000-0000000000000000

# Ten-character Apple developer team ID (Xcode → Settings → Accounts).
# POKEET_TEAM_ID=ABCDE12345

# Build directory, if you want something other than /tmp/pokeet-dd.
# POKEET_DERIVED_DATA=/tmp/pokeet-dd
